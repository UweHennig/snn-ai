digraph SNN {
// Test
 compound=true;
 node [shape=none];
 edge [arrowhead=empty, color=red];
 layout = dot;
 subgraph cluster_receptor {
	 label = "receptor";
	 style = filled;
	 color = lightgrey;
	 anchor_receptor [shape=point, style=invis, label="", width=0, height=0];
0;
 }
 subgraph cluster_associative {
	 label = "associative";
	 style = filled;
	 color = lightgrey;
	 anchor_associative [shape=point, style=invis, label="", width=0, height=0];
3;
4;
5;
 }
 subgraph cluster_feedback {
	 label = "feedback";
	 style = filled;
	 color = lightgrey;
	 anchor_feedback [shape=point, style=invis, label="", width=0, height=0];
6;
7;
8;
9;
 }
 subgraph cluster_effector {
	 label = "effector";
	 style = filled;
	 color = lightgrey;
	 anchor_effector [shape=point, style=invis, label="", width=0, height=0];
1;
2;
 }
 anchor_receptor:s    -> anchor_associative:n [ltail=cluster_receptor, lhead=cluster_associative, color=blue];
 anchor_associative:s ->  anchor_effector:n   [ltail=cluster_associative, lhead=cluster_effector, color=blue];
 anchor_feedback:s    -> anchor_receptor:n    [ltail=cluster_feedback, lhead=cluster_receptor, color=blue];
 anchor_feedback:s    -> anchor_associative:n [ltail=cluster_feedback, lhead=cluster_associative, color=blue];
 anchor_feedback:s    -> anchor_effector:n    [ltail=cluster_feedback, lhead=cluster_effector, color=blue];
// out neighbours
1 -> 2;
2 -> 1;
3 -> 4;
3 -> 5;
4 -> 3;
4 -> 5;
5 -> 4;
5 -> 3;
6 -> 7;
6 -> 9;
7 -> 6;
7 -> 9;
7 -> 8;
8 -> 7;
9 -> 6;
9 -> 7;
}

