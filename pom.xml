<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>com.uwe-hennig</groupId>
	<artifactId>snn-ai</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>AI Spiking Neuronal Network (SNN) with Java</name>
	
	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<maven.compiler.target>26</maven.compiler.target>
		<maven.compiler.source>26</maven.compiler.source>
		<maven.plugin.validation>DEFAULT</maven.plugin.validation>
		<java.version>26</java.version>
		<junit-version>4.13.2</junit-version>
		<snn-version>0.0.1-SNAPSHOT</snn-version>
	</properties>
	
   <licenses>
        <license>
            <name>GNU General Public License v3.0</name>
            <url>https://www.gnu.org/licenses/gpl-3.0.html</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.uwe-hennig</groupId>
                <artifactId>snn-anatomy</artifactId>
                <version>${snn-version}</version>
            </dependency>        
            <dependency>
                <groupId>com.uwe-hennig</groupId>
                <artifactId>snn-cerebro</artifactId>
                <version>${snn-version}</version>
            </dependency>        
            <dependency>
                <groupId>com.uwe-hennig</groupId>
                <artifactId>snn-contracts</artifactId>
                <version>${snn-version}</version>
            </dependency>        
            <dependency>
                <groupId>com.uwe-hennig</groupId>
                <artifactId>snn-system</artifactId>
                <version>${snn-version}</version>
            </dependency>        
            <!-- Source: https://mvnrepository.com/artifact/org.junit.jupiter/junit-jupite -->
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>6.1.0</version>
                <scope>test</scope>
            </dependency> 
        </dependencies>
    </dependencyManagement>
    
	<modules>
        <module>snn-contracts</module>
        	<module>snn-anatomy</module>
        	<module>snn-cerebro</module>
        <module>snn-system</module>
	</modules>
</project>